APP_NAME="Bawa Beres"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bawa_beres
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bawaberes.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public business profile (use verified production details)
BUSINESS_NAME="Bawa Beres"
BUSINESS_LEGAL_NAME="Bawa Beres Indonesia"
BUSINESS_TAGLINE="Layanan Pindahan, Storage & Logistik Kota Malang"
BUSINESS_EMAIL=info@bawaberes.id
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_STREET_ADDRESS=
BUSINESS_DISTRICT=Lowokwaru
BUSINESS_CITY="Kota Malang"
BUSINESS_PROVINCE="Jawa Timur"
BUSINESS_POSTAL_CODE=
BUSINESS_LATITUDE=
BUSINESS_LONGITUDE=
BUSINESS_OPEN_TIME=07:00
BUSINESS_CLOSE_TIME=21:00
BUSINESS_HOURS_DISPLAY="Senin – Minggu: 07.00 – 21.00 WIB"

# Internal operational defaults
BUSINESS_DEFAULT_DISTRICT=Lowokwaru
BUSINESS_DEFAULT_STORAGE_LOCATION="Rak A-01"
BUSINESS_DEFAULT_TEAM=
BUSINESS_DEFAULT_VEHICLE=
BUSINESS_SCHEDULE_START=09:00
BUSINESS_SCHEDULE_END=12:00
BUSINESS_DEFAULT_BANK=
